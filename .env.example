# GitHub App (see README "Register the GitHub App")
GITHUB_APP_ID=
# Either a path to the downloaded .pem file...
GITHUB_APP_PRIVATE_KEY_PATH=./reviewlens.private-key.pem
# ...or the key inline, with newlines escaped as \n
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Infrastructure
REDIS_URL=redis://localhost:6379
DATABASE_URL=postgresql://reviewlens:reviewlens@localhost:5432/reviewlens

# API
PORT=3000
HOST=0.0.0.0

# Worker
WORKER_CONCURRENCY=4
# Embed every indexed symbol into pgvector on push. Slow on free-tier Gemini keys.
INDEX_EMBEDDINGS=false
# Context strategy S0..S5: diff only, + changed files, + similar code (embeddings),
# + symbols and callees, + callers, + conventions and past bugs. See README.
REVIEW_STRATEGY=S1
# Learned usefulness filter (services/filter). Set both to turn it on: comments scored below
# the threshold are dropped. Reviews fail while the service is unreachable.
# FILTER_URL=http://localhost:8000
# REVIEW_FILTER_THRESHOLD=0.1

# LLM: gemini (default) or anthropic
LLM_PROVIDER=gemini
# One or more Gemini API keys, comma-separated. When a key is rate-limited the next one is used.
GEMINI_API_KEYS=
# Free-tier keys are not billed, so recorded cost is 0. Set false for paid keys.
GEMINI_FREE_TIER=true
# Only needed with LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Optional: override the provider's default model (gemini-3.8-flash / claude-opus-5-5)
REVIEW_MODEL=
# Optional: comma-separated models to try when the model is overloaded or out of quota.
# Unset = provider default (gemini-3.5-flash). Set to empty to disable fallback.
# REVIEW_FALLBACK_MODELS=gemini-3.5-flash
# Optional: on-disk LLM response cache
LLM_CACHE_DIR=

# Logging / tracing. Tracing is off unless an OTLP endpoint is set.
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=
