{
  "name": "reviewlens",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:api": "pnpm --filter @reviewlens/api dev",
    "dev:worker": "pnpm --filter @reviewlens/worker dev",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "export:feedback": "tsx --conditions=source apps/worker/src/export-feedback.ts",
    "db:migrate": "pnpm --filter @reviewlens/db migrate:deploy",
    "review": "tsx --conditions=source apps/cli/src/main.ts review",
    "reviewlens": "tsx --conditions=source apps/cli/src/main.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "esbuild",
      "prisma"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.4",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
