{
  "name": "@reviewlens/dashboard",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build",
    "typecheck": "tsc -p tsconfig.json && tsc -p src/client/tsconfig.json",
    "dev:server": "tsx watch --env-file-if-exists=../../.env --conditions=source src/server/main.ts",
    "dev:client": "vite",
    "demo": "vite build && tsx --conditions=source src/server/demo.ts",
    "start": "node --env-file-if-exists=../../.env dist/server/main.js"
  },
  "dependencies": {
    "@reviewlens/db": "workspace:*",
    "@reviewlens/shared": "workspace:*",
    "fastify": "^5.12.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-pgvector": "^0.0.9",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@reviewlens/review-core": "workspace:*",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "vite": "^8.3.4"
  }
}
