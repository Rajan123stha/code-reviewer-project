{
  "name": "@reviewlens/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "dev": "tsx watch --env-file-if-exists=../../.env --conditions=source --import ./src/instrumentation.ts src/main.ts",
    "start": "node --env-file-if-exists=../../.env --import ./dist/instrumentation.js dist/main.js"
  },
  "dependencies": {
    "@reviewlens/shared": "workspace:*",
    "bullmq": "^6.3.11",
    "bullmq-otel": "^2.0.1",
    "fastify": "^5.12.8",
    "ioredis": "^6.0.0",
    "zod": "^4.6.7"
  }
}
